# --- Discord ------------------------------------------------------------
# A bot token (discord.com/developers -> your application -> Bot -> Reset Token)
# and the numeric id of the channel it posts to (Developer Mode on, right-click
# the channel -> Copy Channel ID). The bot needs Send Messages + Embed Links.
DISCORD_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx.xxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxx
DISCORD_CHANNEL_ID=1128281851400835192

# --- Supabase -----------------------------------------------------------
# Project Settings -> API. Use the *service_role* key (server side only).
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOi...service_role...

# --- Search centre (Madrid 28020) ---------------------------------------
WP_LATITUDE=40.44
WP_LONGITUDE=-3.70
WP_DEFAULT_DISTANCE_KM=100

# --- Margin model (all optional, these are the defaults) ----------------
# Wallapop charges the seller 0% commission — only the buyer pays a protection
# fee on shipped/protected purchases. seller_fee is 0 because WE are the seller
# when we resell; buyer_fee/buyer_fixed apply when WE are the buyer.
SELLER_FEE=0
BUYER_FEE=0.075
BUYER_FIXED=0.69
SHIPPING_IN=4.50
TARGET_MARGIN=50

# The required margin is the GREATER of TARGET_MARGIN and MARGIN_RATE*ref_price.
# A flat 50 EUR is a 25% return on a 200 EUR card and 8% on a 620 EUR one, so a
# flat target alone is nearly free at the expensive end. Crossover is 278 EUR at
# these defaults. Set MARGIN_RATE=0 for the old flat-only behaviour.
MARGIN_RATE=0.18

# Extra margin demanded while a model is still on its hand-written seed price
# rather than on real comps. Relaxes by itself once MIN_COMPS comps exist.
SEED_MARGIN_MULTIPLIER=1.6

# How far below the asking price you could realistically haggle a seller down.
# A listing qualifies if the price after this discount would clear the margin
# gate, even when the raw asking price alone wouldn't.
OFFER_DISCOUNT=0.20

# Hard ceiling on the asking price of anything that may trigger an alert,
# applied before any margin maths. Also what keeps whole PCs and gaming laptops
# out of the feed without having to identify them: a machine with a card in it
# is essentially never listed this cheap. Comps are NOT capped.
MAX_ALERT_PRICE=450

# Floor on how far below the reference a listing may sit, as a fraction of it.
# DISABLED (0) by owner decision. It was 0.35 and it guarded the margin engine's
# one blind spot — the more absurd a price, the better the margin it computes —
# but it is symmetric and cannot tell a replica from a genuine steal, so it also
# dropped the single most profitable listings the bot can find. Everything that
# clears the margin is now sent, and a human judges legitimacy from the photos,
# the seller and the description. MIN_SANE_PRICE (50) is the only lower bound
# left. Set to 0.35 to restore the floor; keep it equal to the dashboard's.
MIN_PLAUSIBLE_RATIO=0.65

# --- Comps ---------------------------------------------------------------
# Minimum number of comps before a learned ref_price replaces the seed
MIN_COMPS=5
# Trailing window for comps, in days. Wider than it used to be (was 30) because
# comps now decay with age instead of falling off a cliff.
COMPS_WINDOW_DAYS=60
# A comp's weight halves every this many days
COMPS_HALFLIFE_DAYS=14
# Fraction trimmed off each end of the comps distribution before the quantile
TRIM_FRACTION=0.10
# A reservation can fall through; a completed sale can't.
RESERVED_WEIGHT=0.7
SOLD_WEIGHT=1.0
# Pull toward the sibling-SKU prior, so few comps are trusted less than many:
#   ref = (n*observed + PRIOR_WEIGHT*prior) / (n + PRIOR_WEIGHT)
PRIOR_WEIGHT=5
# Which quantile of the comps distribution counts as "the" resale price.
# 0.5 is the median. Lower it (0.35-0.40) to price in selling quickly rather
# than eventually.
REF_PERCENTILE=0.5

# Condition tiers that must never trigger an alert. Wallapop's enum is
# un_opened / in_box / new / as_good_as_new / good / fair / has_given_it_all.
# Only the bottom tier is blocked: `fair` is a working card with a cosmetic
# flaw, which is exactly what a flip is built on.
BLOCKED_CONDITIONS=has_given_it_all

# --- Runtime ------------------------------------------------------------
# Pages fetched per search (alert loop / comps loop)
ALERT_MAX_PAGES=2
COMPS_MAX_PAGES=5
# `order_by=newest` alone makes the API return a truncated page. Pairing it
# with any time_filter restores a full 40-item one (measured: 34 -> 80 items
# over 2 pages). Valid: today | lastWeek | lastMonth.
ALERT_TIME_FILTER=lastWeek
# Left empty on purpose: the comps loop sorts by most_relevance, which already
# returns full pages, so a time filter here only shrinks the pool (183 -> 166
# over 5 pages). Age decay handles comps recency instead.
COMPS_TIME_FILTER=
# Seconds between Discord messages
DISCORD_RATE_DELAY=0.5
# Set to 1 to log alerts instead of sending them
DRY_RUN=0

# --- Ops -----------------------------------------------------------------
# Rows older than this are deleted by the comps loop. observations is only read
# inside COMPS_WINDOW_DAYS, and junk_exclusions is a tuning aid that gets read
# against what the filters are catching now — it is also the table that once
# reached 2.86M rows and exhausted the free tier.
OBSERVATION_RETENTION_DAYS=21
JUNK_RETENTION_DAYS=7
# Consecutive zero-item runs before the bot reports itself broken
DEAD_MAN_RUNS=3
# Seconds between passes when running `python alert_loop.py --loop` on a
# persistent host. Wallapop's own indexing lags new listings by ~150-200s, so
# polling faster than this buys nothing.
LOOP_INTERVAL_SECONDS=45


# Ceiling on what may enter the reference-price pool, and on a learned
# reference. Separate from MAX_SANE_PRICE on purpose: the alert ceiling asks
# "could this be a trade", this asks "is this a real sale I can learn from".
# Keeping them coupled froze the priciest models on their seed guesses.
MAX_COMP_PRICE=4000

# Pool floor for consoles, overriding MIN_COMP_PRICE for that family alone.
# A console search returns the console's games in bulk and some are titled
# exactly like a console ("PS5 Spiderman 2"). No wording separates them; the
# price does. 150 clears a sealed new release and stays under any real console.
MIN_COMP_PRICE_CONSOLE=150
